---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CodeChip from "../components/CodeChip.astro";
import CtaBand from "../components/CtaBand.astro";
import StoreBadges from "../components/StoreBadges.astro";

const APP = "https://app.skcal.fit";
---

<Layout>
  <Nav />

  <header class="hero">
    <div class="rings"><i class="r1"></i><i class="r2"></i></div>
    <div class="wrap hero-grid">
      <div>
        <h1>The <span class="hl">AI-native</span> way to manage your health.</h1>
        <p class="hero-sub">
          Snap a photo of your food, log your weight, measurements, and workouts, and ask your
          coach anything. skcal tracks everything for you.
        </p>
        <StoreBadges class="hero-badges" />
        <p class="hero-note"># on iPhone and Android, or <a href={APP}>start in the browser</a>.</p>
      </div>
      <img
        class="scene-img shot-light"
        src="/landing/ios-today.jpg"
        alt="The skcal Today view on iPhone, weight down 1.3 lb this week and on track toward a 168 lb goal, with today's calories and protein against target"
        width="945"
        height="2055"
      />
    </div>
  </header>

  <section class="dark">
    <div class="rings"><i class="r1"></i></div>
    <div class="wrap band">
      <div class="band-grid">
        <img
          class="scene-img shot-dark"
          src="/landing/ios-train.jpg"
          alt="The skcal Train view on iPhone, week 2 day 2 of a mesocycle with logged squat sets, rest times, and a live rest timer"
          width="945"
          height="2055"
        />
        <div>
          <h2>Fully customizable, when you want it.</h2>
          <p class="lead">
            Everything the agent does is an API you can call yourself. Wire skcal into
            Claude, your terminal, or your own scripts.
          </p>
          <div class="feat">
            <div class="feat-item">
              <div class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8h12z"></path></svg>
              </div>
              <h3>MCP server, first-class</h3>
              <p>
                Connect Claude, ChatGPT, or Claude Code over OAuth 2.1 with no tokens to paste.
                21 tools, scoped to your account: <code>skcal_log_meal</code>,
                <code>skcal_start_phase</code>, <code>skcal_log_sets</code>…
              </p>
            </div>
            <div class="feat-item">
              <div class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
              </div>
              <h3>A real CLI</h3>
              <p>
                Log weigh-ins, meals, and measurements from your shell. One install, browser or
                API-key sign-in:
              </p>
              <CodeChip cmd="npm i -g @skeptrune/skcal" class="chip-sm" />
            </div>
            <div class="feat-item">
              <div class="ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"></path><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path></svg>
              </div>
              <h3>Typed HTTP API</h3>
              <p>
                OpenAPI 3.1 behind every surface, with scoped bearer keys for scripts and a webhook
                endpoint for your smart scale. It's your data, so pull it however you like.
              </p>
            </div>
          </div>
          <div class="works">
            <h4>Works with</h4>
            <div class="works-row">
              <span>Claude</span>
              <span>Claude Code</span>
              <span>ChatGPT</span>
              <span>Cursor</span>
              <span>any MCP client</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="teaser">
    <div class="wrap teaser-box">
      <div>
        <h2>One plan. Everything.</h2>
        <p>No free tier, no feature matrix. Every surface (iOS, Android, web, agent, MCP, CLI, API) in one price.</p>
      </div>
      <div class="teaser-actions">
        <span class="teaser-price">$10<small>/mo</small></span>
        <a class="btn" href={APP}>Get started</a>
        <a class="tlink" href="/pricing">See what's included</a>
      </div>
    </div>
  </section>

  <CtaBand />

  <Footer />
</Layout>

