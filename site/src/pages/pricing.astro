---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Check from "../components/Check.astro";
import CtaBand from "../components/CtaBand.astro";

const APP = "https://app.skcal.fit";
---

<Layout
  title="Pricing · skcal"
  description="skcal is free, with everything included: AI meal logging, the agent, MCP, CLI, API, and scoped keys. No plans, no card."
>
  <Nav active="pricing" />

  <section class="pricing" style="background: var(--paper);">
    <div class="wrap">
      <div class="sec-head">
        <h2>Free. Everything.</h2>
        <p>No plans, no feature matrix, no “Pro”. All of it costs nothing.</p>
      </div>
      <div class="price-card">
        <div class="price-brand"><span class="mark">sk</span> skcal</div>
        <div class="price-num">Free</div>
        <p class="price-sub">Everything skcal does today, and everything it ships next. No card.</p>
        <ul class="plist">
          <Check>Unlimited AI meal logging: photo, paste, or plain text</Check>
          <Check>The agent: chat, tools, saved &amp; searchable history</Check>
          <Check>MCP server access from any client</Check>
          <Check>CLI, typed API, and scoped API keys</Check>
          <Check>Weight, measurements, targets &amp; trend analytics</Check>
          <Check>Smart-scale ingest webhook</Check>
          <Check>Every new feature, the day it ships</Check>
        </ul>
        <a class="btn" href={APP}>Get started</a>
      </div>

      <div class="faq">
        <h2>Questions</h2>
        <details>
          <summary>Is it really free?</summary>
          <p>
            Yes. Every feature on every surface, with no trial clock, no card, and no paid tier
            holding anything back. Your data stays exportable over the API.
          </p>
        </details>
        <details>
          <summary>What counts as AI meal logging?</summary>
          <p>
            Photos, pasted screenshots, and plain-text descriptions. Claude estimates calories and
            protein per item and writes the entries to your log; you can correct any line in one
            sentence.
          </p>
        </details>
        <details>
          <summary>Are the MCP server and API included?</summary>
          <p>
            Yes. Every surface is included: the app, the agent, the MCP server, the CLI, the HTTP API,
            and scoped API keys. There are no per-seat or per-call charges.
          </p>
        </details>
      </div>
    </div>
  </section>

  <CtaBand />

  <Footer />
</Layout>
